---
import NavMobile from "../components/NavMobile.astro";
import NavDesktop from "../components/NavDesktop.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const {
  title = "Ceche — Domain Appraisal Engine",
  description = "Domain Appraisal Engine — evaluate any domain across 16 dimensions",
  active,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="ceche">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={Astro.url.href} />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      html { scroll-behavior: auto; overflow: hidden; }
      body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; overflow-x: hidden; }
      #lenis-wrapper { overflow-y: scroll; height: 100dvh; }
      @media (max-width: 767px) {
        #lenis-wrapper { height: calc(100dvh - 56px); }
      }
      [data-aos] { opacity: 0; transition: opacity 0.5s ease; }
      [data-aos].aos-animate { opacity: 1; }
      .prose pre code { background: none !important; padding: 0 !important; color: inherit !important; font-size: 0.875em !important; }
      .prose code::before, .prose code::after { content: none !important; }
      .prose ul { list-style-type: disc; padding-left: 1.25em; }
      .prose ol { list-style-type: decimal; padding-left: 1.25em; }
      .prose li { margin-top: 0.25em; margin-bottom: 0.25em; }
      .prose img { border-radius: 0.75rem; }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
        [data-aos] { opacity: 1 !important; }
        #lenis-wrapper { overflow-y: auto; height: auto; }
        html { overflow: auto; }
      }
    </style>
  </head>
  <body class="bg-base-100 text-base-content">
    <!-- Mobile layout -->
    <div class="block md:hidden">
      <div id="lenis-wrapper">
        <main class="pb-4">
          <slot />
        </main>
        <Footer />
      </div>
      <NavMobile active={active} />
    </div>

    <!-- Desktop layout -->
    <div class="hidden md:block">
      <NavDesktop active={active} />
      <div id="lenis-wrapper-desktop">
        <main>
          <slot />
        </main>
        <Footer />
      </div>
    </div>

    <script>
      // Theme toggle
      const sun = document.getElementById('sun-icon');
      const moon = document.getElementById('moon-icon');
      const btn = document.getElementById('theme-toggle');
      if (btn) {
        const saved = localStorage.getItem('ceche-theme') || 'ceche';
        document.documentElement.setAttribute('data-theme', saved);
        updateIcons(saved);
        btn.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme');
          const next = current === 'cechelight' ? 'ceche' : 'cechelight';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('ceche-theme', next);
          updateIcons(next);
        });
      }
      function updateIcons(theme) {
        if (!sun || !moon) return;
        const isDark = theme === 'ceche';
        sun.classList.toggle('hidden', isDark);
        moon.classList.toggle('hidden', !isDark);
      }

      // Plausible analytics
      const script = document.createElement('script');
      script.src = 'https://plausible.io/js/script.js';
      script.setAttribute('data-domain', 'ceche.app');
      script.defer = true;
      document.head.appendChild(script);

      // Maintenance mode check
      fetch('/admin/api/settings/maintenance_mode')
        .then(r => r.json())
        .then(d => {
          if (d.value === 'true') {
            document.body.innerHTML = '<div style="height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg);color:var(--text);font-family:sans-serif"><div style="text-align:center"><h1 style="font-size:2rem;margin-bottom:1rem">Under Maintenance</h1><p style="opacity:0.6">Ceche will be back shortly.</p></div></div>';
          }
        })
        .catch(() => {});

      // GitHub stars
      fetch('https://api.github.com/repos/cocor-tech/Ceche')
        .then(r => r.json())
        .then(d => {
          document.querySelectorAll('#github-stars, #github-stars-desktop').forEach(el => {
            el.textContent = (d.stargazers_count || '0').toLocaleString();
          });
        })
        .catch(() => {});

      // Domain counter
      fetch('/admin/api/stats')
        .then(r => r.json())
        .then(d => {
          document.querySelectorAll('#domain-counter, #domain-counter-desktop, #domain-count-home, #domain-count-home-desktop').forEach(el => {
            if (el) el.textContent = (d.total_appraisals || 0).toLocaleString();
          });
        })
        .catch(() => {});

      // Lenis smooth scroll (desktop only)
      const wrapper = document.getElementById('lenis-wrapper-desktop') || document.getElementById('lenis-wrapper');
      if (wrapper && window.innerWidth > 767 && typeof Lenis !== 'undefined') {
        const lenis = new Lenis({ wrapper: wrapper, content: wrapper, lerp: 0.07, smoothWheel: true });
        lenis.on('scroll', () => {});
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);
      }

      // AOS
      if (typeof AOS !== 'undefined') {
        AOS.init({ once: true, duration: 600, offset: 80, disable: window.innerWidth < 768 });
      }
    </script>
    <Fragment set:html={`
      <script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
      <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    `} />
  </body>
</html>
