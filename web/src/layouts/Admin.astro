---
export interface Props {
  title?: string;
}

const { title = "Admin — Ceche" } = Astro.props;
const token = Astro.cookies.get("ceche_admin_token")?.value;
const isAuthenticated = !!token;
---

<!DOCTYPE html>
<html lang="en" data-theme="ceche">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      html { scroll-behavior: smooth; }
      body { font-family: 'Inter', sans-serif; }
    </style>
  </head>
  <body class="bg-base-100 text-base-content min-h-screen">
    {
      isAuthenticated ? (
        <div class="flex min-h-screen">
          <!-- Sidebar -->
          <aside class="w-64 bg-base-200 border-r border-[#1a261a] p-4">
            <div class="text-lg font-bold mb-8">ceche admin</div>
            <nav class="flex flex-col gap-2 text-sm">
              <a href="/admin" class="px-3 py-2 rounded-lg hover:bg-base-300 transition-colors">Dashboard</a>
              <a href="/admin/domains" class="px-3 py-2 rounded-lg hover:bg-base-300 transition-colors">Domains</a>
              <a href="/admin/blog" class="px-3 py-2 rounded-lg hover:bg-base-300 transition-colors">Blog</a>
              <a href="/admin/docs" class="px-3 py-2 rounded-lg hover:bg-base-300 transition-colors">Documentation</a>
              <hr class="border-[#1a261a] my-2" />
              <a href="/admin/settings" class="px-3 py-2 rounded-lg hover:bg-base-300 transition-colors">Settings</a>
              <a href="/admin/api-keys" class="px-3 py-2 rounded-lg hover:bg-base-300 transition-colors">API Keys</a>
              <a href="/admin/rate-limits" class="px-3 py-2 rounded-lg hover:bg-base-300 transition-colors">Rate Limits</a>
              <a href="/admin/users" class="px-3 py-2 rounded-lg hover:bg-base-300 transition-colors">Users</a>
              <hr class="border-[#1a261a] my-2" />
              <a href="/admin/logout" class="px-3 py-2 rounded-lg hover:bg-red-900/30 text-red-400 transition-colors">Logout</a>
            </nav>
          </aside>

          <!-- Main content -->
          <main class="flex-1 p-8">
            <slot />
          </main>
        </div>
      ) : (
        <div class="flex items-center justify-center min-h-screen">
          <div class="text-center">
            <h1 class="text-2xl font-bold mb-4">Admin Login</h1>
            <form method="POST" action="/admin/api/login" class="flex flex-col gap-4 max-w-sm mx-auto">
              <input type="email" name="email" placeholder="Email" required class="input input-bordered w-full" />
              <input type="password" name="password" placeholder="Password" required class="input input-bordered w-full" />
              <button type="submit" class="btn btn-primary">Sign In</button>
            </form>
          </div>
        </div>
      )
    }
  </body>
</html>
