---
const links = [
  { href: "/", label: "Appraise" },
  { href: "/pricing", label: "Pricing" },
  { href: "/enterprise", label: "Enterprise" },
  { href: "/blog/", label: "Blog" },
  { href: "/faq", label: "FAQ" },
  { href: "/contact", label: "Contact" },
];
const year = new Date().getFullYear();
---

<!-- Mobile footer -->
<footer class="block md:hidden border-t border-base-300 mt-24 py-8 px-4">
  <div class="text-center text-body-sm text-base-content/50">
    <p class="mb-3">&copy; {year} Ceche. MIT License.</p>
    <div class="flex justify-center gap-4 text-caption uppercase tracking-wider">
      <a href="/terms" class="hover:text-primary transition-colors">Terms</a>
      <a href="/privacy" class="hover:text-primary transition-colors">Privacy</a>
      <a href="/blog/" class="hover:text-primary transition-colors">Blog</a>
    </div>
  </div>
</footer>

<!-- Desktop footer -->
<footer class="hidden md:block border-t border-base-300 mt-32 py-16">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-4 gap-12">
      <div class="col-span-2">
        <a href="/" class="text-2xl font-display font-bold tracking-tight text-base-content">
          ceche
        </a>
        <p class="mt-3 text-body-sm text-base-content/50 max-w-sm">
          Domain appraisal engine powered by 16 valuation modules. Open source, transparent, instant.
        </p>
      </div>
      <div>
        <h4 class="text-caption text-base-content/40 uppercase tracking-wider mb-4">Product</h4>
        <div class="flex flex-col gap-2.5">
          {links.slice(0, 4).map((link) => (
            <a href={link.href} class="text-body-sm text-base-content/60 hover:text-primary transition-colors">
              {link.label}
            </a>
          ))}
        </div>
      </div>
      <div>
        <h4 class="text-caption text-base-content/40 uppercase tracking-wider mb-4">Company</h4>
        <div class="flex flex-col gap-2.5">
          {links.slice(4).map((link) => (
            <a href={link.href} class="text-body-sm text-base-content/60 hover:text-primary transition-colors">
              {link.label}
            </a>
          ))}
          <a href="https://github.com/cocor-tech/Ceche" target="_blank" rel="noopener" class="text-body-sm text-base-content/60 hover:text-primary transition-colors">
            GitHub
          </a>
          <a href="https://github.com/cocor-tech/Ceche/issues" target="_blank" rel="noopener" class="text-body-sm text-base-content/60 hover:text-primary transition-colors">
            Issues
          </a>
        </div>
      </div>
    </div>
    <div class="mt-12 pt-8 border-t border-base-300 flex items-center justify-between text-body-sm text-base-content/40">
      <p>&copy; {year} Ceche. Open source under MIT License.</p>
      <div class="flex items-center gap-2">
        <a href="/privacy" class="hover:text-base-content/60 transition-colors">Privacy</a>
        <span>&middot;</span>
        <a href="/terms" class="hover:text-base-content/60 transition-colors">Terms</a>
        <span>&middot;</span>
        <a href="/contact" class="hover:text-base-content/60 transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
