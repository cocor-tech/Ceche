---
export interface Props {
  content: string;
}
const { content } = Astro.props;

function renderMd(md: string): string {
  if (!md) return '';
  let html = md
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/^---$/gm, '<hr class="my-8 border-base-300" />')
    .replace(/^&gt; (.+)$/gm, '<blockquote class="border-l-4 border-primary pl-5 my-6 text-base-content/60 italic">$1</blockquote>')
    .replace(/```(\w*)\n([\s\S]*?)```/g, (_, lang, code) => {
      return '<pre class="bg-base-200 border border-base-300 rounded-xl p-5 my-6 overflow-x-auto text-body-sm"><code' + (lang ? ' class="language-' + lang + '"' : '') + '>' + code.trim().replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</code></pre>';
    })
    .replace(/`([^`]+)`/g, '<code class="text-primary bg-primary/10 px-1.5 py-0.5 rounded text-body-sm font-mono">$1</code>')
    .replace(/^#### (.+)$/gm, '<h4 class="text-heading-3 font-display mt-8 mb-3">$1</h4>')
    .replace(/^### (.+)$/gm, '<h3 class="text-heading-2 font-display mt-10 mb-3">$1</h3>')
    .replace(/^## (.+)$/gm, '<h2 class="text-heading-1 font-display mt-12 mb-4">$1</h2>')
    .replace(/^# (.+)$/gm, '<h1 class="text-display-3 font-display mt-14 mb-4">$1</h1>')
    .replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>')
    .replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1" class="rounded-xl w-full my-8" loading="lazy" />')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-primary hover:underline" target="_blank" rel="noopener">$1</a>')
    .replace(/^[\*\-] (.+)$/gm, '<li class="ml-5 list-disc text-content marker:text-base-content/40">$1</li>')
    .replace(/^\d+\. (.+)$/gm, '<li class="ml-5 list-decimal text-content marker:text-base-content/40">$1</li>');
  return html;
}

const rendered = renderMd(content);
---

<Fragment set:html={rendered} />
