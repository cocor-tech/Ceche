---
import ThemeToggle from "./ThemeToggle.astro";

export interface Props {
  active?: string;
}
const { active } = Astro.props;
const navLinks = [
  { href: "/pricing", label: "Pricing" },
  { href: "/enterprise", label: "Enterprise" },
  { href: "/blog/", label: "Blog" },
  { href: "/faq", label: "FAQ" },
];
---

<nav class="hidden md:block sticky top-0 z-50 bg-base-100/90 backdrop-blur-lg border-b border-base-300">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center gap-10">
        <a href="/" class="text-xl font-display font-bold tracking-tight text-base-content">
          ceche
        </a>
        <div class="flex items-center gap-1">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class={`
                px-3 py-2 text-body-sm rounded-lg transition-colors
                ${active === link.href ? "text-primary bg-primary/10" : "text-base-content/60 hover:text-base-content hover:bg-base-300/50"}
              `}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a
          href="https://github.com/cocor-tech/Ceche"
          target="_blank"
          rel="noopener"
          class="flex items-center gap-1.5 text-body-sm text-base-content/50 hover:text-base-content transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          <span class="hidden lg:inline">Star on GitHub</span>
        </a>
        <ThemeToggle />
        <a href="/" class="btn btn-primary btn-sm">Appraise a Domain</a>
      </div>
    </div>
  </div>
</nav>
