---
import Base from "../layouts/Base.astro";

const { title = "Domain Appraisal — Ceche", description = "Check the value of any domain instantly. Free domain appraisal tool powered by 16 valuation modules." } = Astro.props;
---

<Base title={title} description={description}>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center" data-aos="fade-up">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">Domain Appraisal</h1>
      <p class="mt-4 text-lg text-[#9ca3af]">Enter any domain to see its estimated value across 16 dimensions.</p>
    </div>

    <div class="mt-10 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="100">
      <form id="appraise-form" class="flex gap-3">
        <input type="text" id="domain-input" placeholder="example.com" required
          class="flex-1 input input-bordered input-lg text-center" />
        <button type="submit" class="btn btn-primary btn-lg px-8">Appraise</button>
      </form>
    </div>

    <!-- Loading (skeleton) -->
    <div id="loading" class="mt-8 hidden" data-aos="fade-up">
      <div class="card bg-base-200 border border-[#1a261a] p-8 max-w-2xl mx-auto">
        <div class="skeleton h-5 w-32 mx-auto mb-4"></div>
        <div class="skeleton h-12 w-56 mx-auto mb-3"></div>
        <div class="skeleton h-4 w-44 mx-auto mb-2"></div>
        <div class="skeleton h-4 w-28 mx-auto"></div>
      </div>
    </div>

    <!-- Error -->
    <div id="error-card" class="mt-8 hidden max-w-md mx-auto" data-aos="fade-up">
      <div class="card bg-base-200 border border-[#1a261a] p-6 text-center">
        <p id="error-message" class="text-red-400"></p>
      </div>
    </div>

    <!-- Result -->
    <div id="result-card" class="mt-8 hidden" data-aos="fade-up" data-aos-delay="200">
      <div class="card bg-base-200 border border-[#1a261a] p-8 max-w-2xl mx-auto">
        <div class="text-center">
          <p id="domain-name" class="text-sm text-[#ff8800] font-semibold uppercase tracking-wider"></p>
          <p id="estimated-value" class="text-5xl font-bold mt-3"></p>
          <p id="range" class="text-sm text-[#9ca3af] mt-2"></p>
          <p id="confidence" class="text-sm mt-1"></p>
        </div>

        <div class="mt-8 border-t border-[#1a261a] pt-6">
          <h3 class="text-sm font-semibold text-[#9ca3af] uppercase tracking-wider mb-4">Module Breakdown</h3>
          <div id="module-breakdown" class="space-y-2"></div>
        </div>

        <div class="mt-6 text-center text-xs text-[#9ca3af]">
          Powered by Ceche — 16 valuation modules
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const api = '/api';
  const form = document.getElementById('appraise-form');
  const input = document.getElementById('domain-input');
  const loading = document.getElementById('loading');
  const errorCard = document.getElementById('error-card');
  const errorMsg = document.getElementById('error-message');
  const result = document.getElementById('result-card');
  const domainName = document.getElementById('domain-name');
  const estimatedValue = document.getElementById('estimated-value');
  const range = document.getElementById('range');
  const confidence = document.getElementById('confidence');
  const breakdown = document.getElementById('module-breakdown');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = input.value.trim();
    if (!domain) return;

    result.classList.add('hidden');
    errorCard.classList.add('hidden');
    loading.classList.remove('hidden');

    try {
      const res = await fetch('/api/appraise', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ domain }),
      });

      if (!res.ok) {
        const errData = await res.json().catch(() => ({ detail: 'Appraisal failed' }));
        throw new Error(errData.detail || `Error ${res.status}`);
      }

      const data = await res.json();

      domainName.textContent = data.domain;
      estimatedValue.textContent = data.estimated_value
        ? '$' + Number(data.estimated_value).toLocaleString(undefined, { maximumFractionDigits: 0 })
        : '--';
      range.textContent = data.range
        ? 'Range: $' + Number(data.range.low || 0).toLocaleString() + ' - $' + Number(data.range.high || 0).toLocaleString()
        : '';
      confidence.textContent = data.confidence
        ? 'Confidence: ' + data.confidence
        : '';

      // Module breakdown
      breakdown.innerHTML = '';
      if (data.modules) {
        const names = Object.keys(data.modules).filter(n => data.modules[n]?.status);
        for (const name of names) {
          const mod = data.modules[name];
          const label = name.replace(/^m(\d+)_/, 'M$1 ').replace(/_/g, ' ');
          const status = mod.status || '--';
          const val = mod.value || mod.score || mod.multiplier || '';
          const bar = document.createElement('div');
          bar.className = 'flex items-center justify-between text-sm py-1.5 border-b border-[#1a261a] last:border-0';
          bar.innerHTML = `
            <span class="text-[#9ca3af] capitalize">${label}</span>
            <span class="${status === 'SUCCESS' ? 'text-green-400' : status === 'SKIPPED' ? 'text-yellow-500' : 'text-red-400'}">${status}</span>
          `;
          breakdown.appendChild(bar);
        }
      }

      result.classList.remove('hidden');
    } catch (err) {
      errorMsg.textContent = err.message || 'Could not appraise domain';
      errorCard.classList.remove('hidden');
    } finally {
      loading.classList.add('hidden');
    }
  });
</script>
