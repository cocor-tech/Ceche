---
import Base from "../layouts/Base.astro";
const title = "Enterprise — Ceche";
const description = "Enterprise-grade domain valuation API for high-volume investors, registrars, and marketplaces.";
---

<Base title={title} description={description} active="enterprise">
  <!-- Mobile -->
  <section class="block md:hidden px-4 pt-6 pb-4">
    <div class="text-center mb-6">
      <h1 class="text-heading-1 font-display">Enterprise</h1>
      <p class="mt-1 text-body-sm text-base-content/50">Domain valuation at scale.</p>
    </div>
    <div id="features-mobile" class="space-y-3">
      {[1,2,3,4,5,6].map(() => `
        <div class="card bg-base-200/70 border border-base-300 p-4">
          <div class="skeleton h-5 w-32 mb-2"></div>
          <div class="skeleton h-3 w-full"></div>
        </div>
      `).join('')}
    </div>
    <div class="mt-8 card bg-base-200 border border-base-300 p-6 text-center">
      <h2 class="text-heading-2 font-display">Ready to scale?</h2>
      <p class="mt-2 text-body-sm text-base-content/50">Tell us about your use case.</p>
      <a href="https://github.com/cocor-tech/Ceche/issues" target="_blank" class="btn btn-primary w-full mt-4">Contact Sales</a>
    </div>
  </section>

  <!-- Desktop -->
  <section class="hidden md:block max-w-7xl mx-auto px-6 py-24">
    <div class="text-center max-w-3xl mx-auto">
      <p class="text-caption text-primary uppercase tracking-wider">Enterprise</p>
      <h1 class="text-display-2 font-display mt-2">Domain valuation at enterprise scale</h1>
      <p class="mt-3 text-body-lg text-base-content/60">For high-volume investors, registrars, and marketplaces that need reliable domain appraisal at scale.</p>
    </div>
    <div id="features-desktop" class="mt-20 grid grid-cols-3 gap-6">
      {[1,2,3,4,5,6].map(() => `
        <div class="card bg-base-200/50 border border-base-300 p-6">
          <div class="skeleton h-5 w-32 mb-3"></div>
          <div class="skeleton h-4 w-full mb-2"></div>
          <div class="skeleton h-4 w-3/4"></div>
        </div>
      `).join('')}
    </div>
    <div class="mt-20 text-center">
      <div class="max-w-2xl mx-auto card bg-gradient-to-br from-primary/5 to-primary/10 border border-primary/20 p-12">
        <h2 class="text-heading-1 font-display">Ready to scale your valuation?</h2>
        <p class="mt-3 text-body-lg text-base-content/60">Tell us about your use case and we will build a plan around your needs.</p>
        <a href="https://github.com/cocor-tech/Ceche/issues" target="_blank" class="btn btn-primary btn-lg mt-8">Contact Sales</a>
      </div>
    </div>
  </section>
</Base>

<script>
async function load() {
  try {
    const r = await fetch('/api/features');
    const features = await r.json();
    const mobileContainer = document.getElementById('features-mobile');
    const desktopContainer = document.getElementById('features-desktop');
    if (!features.length) {
      [mobileContainer, desktopContainer].forEach(el => { if (el) el.innerHTML = '<p class="text-center text-base-content/50 py-16">No features configured.</p>'; });
      return;
    }
    if (mobileContainer) {
      mobileContainer.innerHTML = features.map(f => `
        <div class="card bg-base-200/70 border border-base-300 p-5">
          <h3 class="text-heading-3 font-display">${f.title}</h3>
          <p class="mt-2 text-body-sm text-base-content/60">${f.description}</p>
        </div>
      `).join('');
    }
    if (desktopContainer) {
      desktopContainer.innerHTML = features.map(f => `
        <div class="card bg-base-200/50 border border-base-300 p-6 hover:shadow-card-hover transition-shadow">
          <h3 class="text-heading-3 font-display">${f.title}</h3>
          <p class="mt-3 text-body-sm text-base-content/60 leading-relaxed">${f.description}</p>
        </div>
      `).join('');
    }
  } catch {
    [document.getElementById('features-mobile'), document.getElementById('features-desktop')].forEach(el => { if (el) el.innerHTML = '<p class="text-center text-error py-16">Failed to load features.</p>'; });
  }
}
load();
</script>
