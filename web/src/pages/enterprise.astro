---
import Base from "../layouts/Base.astro";
const title = "Enterprise — Ceche";
const description = "Enterprise-grade domain valuation API for high-volume investors, registrars, and marketplaces.";
---

<Base title={title} description={description}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="text-center max-w-3xl mx-auto" data-aos="fade-up">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">Enterprise Domain Valuation</h1>
      <p class="mt-4 text-lg text-[#9ca3af]">For high-volume investors, registrars, and marketplaces that need reliable domain appraisal at scale.</p>
    </div>
    <div id="features-container" class="mt-20 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"></div>
    <div id="features-loading" class="mt-20 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      ${[1,2,3,4,5,6].map(() => '<div class="card bg-base-200 border border-[#1a261a] p-6"><div class="skeleton h-5 w-32 mb-3"></div><div class="skeleton h-4 w-full mb-2"></div><div class="skeleton h-4 w-3/4"></div></div>').join('')}
    </div>
    <div class="mt-20 text-center" data-aos="fade-up" data-aos-delay="200">
      <div class="max-w-2xl mx-auto bg-base-200 border border-[#1a261a] rounded-2xl p-10">
        <h2 class="text-2xl font-bold">Ready to scale?</h2>
        <p class="mt-3 text-[#9ca3af]">Tell us about your use case and we'll build a plan around your needs.</p>
        <a href="https://github.com/cocor-tech/Ceche/issues" target="_blank" class="btn btn-primary btn-lg mt-6">Contact Sales</a>
      </div>
    </div>
  </section>
</Base>

<script>
async function load() {
  try {
    const r = await fetch('/api/features');
    const features = await r.json();
    const container = document.getElementById('features-container');
    document.getElementById('features-loading').style.display = 'none';
    container.innerHTML = features.map(f => `
      <div class="card bg-base-200 border border-[#1a261a] p-6" data-aos="fade-up">
        <h3 class="text-lg font-semibold">${f.title}</h3>
        <p class="mt-3 text-sm text-[#9ca3af]">${f.description}</p>
      </div>
    `).join('');
  } catch(e) {
    document.getElementById('features-loading').innerHTML = '<p class="col-span-full text-center text-red-400">Failed to load features.</p>';
  }
}
load();
</script>
