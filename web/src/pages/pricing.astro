---
import Base from "../layouts/Base.astro";

const { title = "Pricing — Ceche", description = "Free domain appraisal CLI, affordable API access, and enterprise plans for high-volume domain investors." } = Astro.props;
---

<Base title={title} description={description}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="text-center" data-aos="fade-up">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">Simple Pricing</h1>
      <p class="mt-4 text-lg text-[#9ca3af]">Start free. Scale as you grow.</p>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <!-- Free Tier -->
      <div class="card bg-base-200 border border-[#1a261a] p-8" data-aos="fade-up" data-aos-delay="0">
        <h3 class="text-lg font-semibold">CLI</h3>
        <p class="text-3xl font-bold mt-4">Free</p>
        <p class="text-sm text-[#9ca3af] mt-1">Open source</p>
        <ul class="mt-6 space-y-3 text-sm">
          <li class="flex items-start gap-2">
            <span class="text-[#22c55e] mt-0.5">&#10003;</span> Single domain appraisal
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#22c55e] mt-0.5">&#10003;</span> Bulk check (up to 100 domains)
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#22c55e] mt-0.5">&#10003;</span> Terminal UI (TUI)
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#22c55e] mt-0.5">&#10003;</span> All 16 modules
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#22c55e] mt-0.5">&#10003;</span> MIT License
          </li>
        </ul>
        <a href="https://github.com/cocor-tech/Ceche" target="_blank" rel="noopener" class="btn btn-outline btn-primary w-full mt-8">
          Get Started
        </a>
      </div>

      <!-- API Tier -->
      <div class="card bg-base-200 border-2 border-[#ff8800] p-8 relative" data-aos="fade-up" data-aos-delay="100">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#ff8800] text-white text-xs font-semibold px-4 py-0.5 rounded-full">
          Recommended
        </div>
        <h3 class="text-lg font-semibold">API</h3>
        <p class="text-3xl font-bold mt-4">$49<span class="text-lg text-[#9ca3af]">/mo</span></p>
        <p class="text-sm text-[#9ca3af] mt-1">1,000 appraisals/mo</p>
        <ul class="mt-6 space-y-3 text-sm">
          <li class="flex items-start gap-2">
            <span class="text-[#22c55e] mt-0.5">&#10003;</span> REST API access
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#22c55e] mt-0.5">&#10003;</span> Bulk check (unlimited)
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#22c55e] mt-0.5">&#10003;</span> Web dashboard
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#22c55e] mt-0.5">&#10003;</span> Appraisal history
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#22c55e] mt-0.5">&#10003;</span> CSV export
          </li>
        </ul>
        <a href="https://github.com/cocor-tech/Ceche/issues" class="btn btn-primary w-full mt-8">Start Free Trial</a>
      </div>

      <!-- Enterprise Tier -->
      <div class="card bg-base-200 border border-[#1a261a] p-8" data-aos="fade-up" data-aos-delay="200">
        <h3 class="text-lg font-semibold">Enterprise</h3>
        <p class="text-3xl font-bold mt-4">Custom</p>
        <p class="text-sm text-[#9ca3af] mt-1">Volume pricing</p>
        <ul class="mt-6 space-y-3 text-sm">
          <li class="flex items-start gap-2">
            <span class="text-[#22c55e] mt-0.5">&#10003;</span> Self-hosted option
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#22c55e] mt-0.5">&#10003;</span> SLA guarantee
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#22c55e] mt-0.5">&#10003;</span> SSO / SAML
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#22c55e] mt-0.5">&#10003;</span> Priority support
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#22c55e] mt-0.5">&#10003;</span> Custom integrations
          </li>
        </ul>
        <a href="https://github.com/cocor-tech/Ceche/issues" class="btn btn-outline btn-primary w-full mt-8">Contact Sales</a>
      </div>
    </div>
  </section>
</Base>
