---
import Base from "../layouts/Base.astro";
const title = "Pricing — Ceche";
const description = "Free domain appraisal CLI, affordable API access, and enterprise plans for high-volume domain investors.";
---

<Base title={title} description={description}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="text-center" data-aos="fade-up">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">Simple Pricing</h1>
      <p class="mt-4 text-lg text-[#9ca3af]">Start free. Scale as you grow.</p>
    </div>
    <div id="pricing-container" class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <div class="col-span-full text-center text-[#9ca3af] py-16"><div class="skeleton h-6 w-48 mx-auto mb-4"></div><div class="skeleton h-4 w-64 mx-auto"></div></div>
    </div>
  </section>
</Base>

<script>
async function load() {
  try {
    const r = await fetch('/api/pricing');
    const tiers = await r.json();
    const container = document.getElementById('pricing-container');
    if (!tiers.length) { container.innerHTML = '<p class="col-span-full text-center text-[#9ca3af]">No pricing configured.</p>'; return; }
    container.innerHTML = tiers.map(t => `
      <div class="card bg-base-200 border ${t.highlighted ? 'border-2 border-[#ff8800]' : 'border-[#1a261a]'} p-8 relative">
        ${t.highlighted ? '<div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#ff8800] text-white text-xs font-semibold px-4 py-0.5 rounded-full">Recommended</div>' : ''}
        <h3 class="text-lg font-semibold">${t.name}</h3>
        <p class="text-3xl font-bold mt-4">${t.price_label}</p>
        ${t.price_subtext ? `<p class="text-sm text-[#9ca3af] mt-1">${t.price_subtext}</p>` : ''}
        <ul class="mt-6 space-y-3 text-sm">
          ${(t.features || []).map(f => `<li class="flex items-start gap-2"><span class="text-[#22c55e] mt-0.5">&#10003;</span> ${f}</li>`).join('')}
        </ul>
        <a href="${t.cta_url || '/appraise'}" class="btn ${t.highlighted ? 'btn-primary' : 'btn-outline btn-primary'} w-full mt-8">${t.cta_label}</a>
      </div>
    `).join('');
  } catch(e) {
    document.getElementById('pricing-container').innerHTML = '<p class="col-span-full text-center text-red-400">Failed to load pricing.</p>';
  }
}
load();
</script>
