---
import Base from "../layouts/Base.astro";
const title = "Contact — Ceche";
const description = "Get in touch with the Ceche team. Sales inquiries, support requests, and partnership opportunities.";
---

<Base title={title} description={description}>
  <!-- Mobile -->
  <section class="block md:hidden px-4 pt-6 pb-4">
    <div class="text-center mb-6">
      <h1 class="text-heading-1 font-display">Contact</h1>
      <p class="mt-1 text-body-sm text-base-content/50">We would love to hear from you.</p>
    </div>
    <div class="card bg-base-200/70 border border-base-300 p-5 mb-4">
      <form action="https://formspree.io/f/your-id" method="POST" class="space-y-4">
        <input type="text" name="name" placeholder="Name" required class="input input-bordered w-full bg-base-100 text-base-content" />
        <input type="email" name="email" placeholder="Email" required class="input input-bordered w-full bg-base-100 text-base-content" />
        <input type="text" name="subject" placeholder="Subject" required class="input input-bordered w-full bg-base-100 text-base-content" />
        <textarea name="message" rows="4" placeholder="Message" required class="textarea textarea-bordered w-full bg-base-100 text-base-content"></textarea>
        <button type="submit" class="btn btn-primary w-full">Send</button>
      </form>
    </div>
    <div class="space-y-2">
      {[
        { label: "GitHub", value: "github.com/cocor-tech/Ceche", href: "https://github.com/cocor-tech/Ceche" },
        { label: "Email", value: "hello@ceche.app", href: "mailto:hello@ceche.app" },
      ].map(item => (
        <a href={item.href} target="_blank" rel="noopener" class="card bg-base-200/50 border border-base-300 p-4 flex items-center justify-between">
          <span class="text-body-sm text-base-content/60">{item.label}</span>
          <span class="text-body-sm font-medium">{item.value}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Desktop -->
  <section class="hidden md:block max-w-5xl mx-auto px-6 py-24">
    <div class="text-center max-w-2xl mx-auto">
      <p class="text-caption text-primary uppercase tracking-wider">Contact</p>
      <h1 class="text-display-2 font-display mt-2">Get in touch</h1>
      <p class="mt-3 text-body-lg text-base-content/60">Have questions? We would love to hear from you.</p>
    </div>
    <div class="mt-16 grid grid-cols-2 gap-12">
      <div class="card bg-base-200/50 border border-base-300 p-8">
        <form action="https://formspree.io/f/your-id" method="POST" class="space-y-5">
          <div class="grid grid-cols-2 gap-4">
            <input type="text" name="name" placeholder="Name" required class="input input-bordered w-full bg-base-100 text-base-content" />
            <input type="email" name="email" placeholder="Email" required class="input input-bordered w-full bg-base-100 text-base-content" />
          </div>
          <input type="text" name="subject" placeholder="Subject" required class="input input-bordered w-full bg-base-100 text-base-content" />
          <textarea name="message" rows="5" placeholder="Message" required class="textarea textarea-bordered w-full bg-base-100 text-base-content"></textarea>
          <button type="submit" class="btn btn-primary w-full">Send Message</button>
        </form>
      </div>
      <div class="space-y-6">
        {[
          { label: "GitHub", value: "github.com/cocor-tech/Ceche", href: "https://github.com/cocor-tech/Ceche", desc: "Report bugs, request features, or ask questions." },
          { label: "Email", value: "hello@ceche.app", href: "mailto:hello@ceche.app", desc: "Sales inquiries, partnerships, and support." },
          { label: "Issues", value: "Report a bug", href: "https://github.com/cocor-tech/Ceche/issues", desc: "Open a GitHub issue for technical support." },
        ].map(item => (
          <a href={item.href} target="_blank" rel="noopener" class="card bg-base-200/50 border border-base-300 p-6 block hover:shadow-card-hover transition-shadow">
            <p class="text-caption text-primary uppercase tracking-wider">{item.label}</p>
            <p class="mt-1 text-body font-medium">{item.value}</p>
            <p class="mt-1 text-body-sm text-base-content/50">{item.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
