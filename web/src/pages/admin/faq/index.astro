---
import Admin from "../../../layouts/Admin.astro";
---

<Admin title="FAQ — Ceche Admin">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">FAQ Items</h1>
    <button class="btn btn-primary btn-sm" onclick="addItem()">Add Item</button>
  </div>
  <div class="bg-base-200 rounded-xl border border-[#1a261a] overflow-x-auto">
    <table class="table table-sm w-full">
      <thead><tr class="text-[#9ca3af] text-sm border-b border-[#1a261a]"><th class="text-left p-3">Question</th><th class="text-center p-3">Order</th><th class="text-center p-3">Active</th><th class="text-center p-3">Actions</th></tr></thead>
      <tbody id="faq-table"><tr><td colspan="4" class="text-center text-[#9ca3af] py-8">Loading...</td></tr></tbody>
    </table>
  </div>
</Admin>

<script>
async function load() {
  const r = await fetch('/admin/api/faq'); const d = await r.json();
  const t = document.getElementById('faq-table');
  if (!d.length) { t.innerHTML = '<tr><td colspan="4" class="text-center text-[#9ca3af] py-8">No items yet.</td></tr>'; return; }
  t.innerHTML = d.map(i => `<tr class="border-b border-[#1a261a]"><td class="p-3">${i.question?.slice(0,80)}</td><td class="text-center p-3">${i.sort_order}</td><td class="text-center p-3">${i.active ? '<span class="text-green-400">Yes</span>' : 'No'}</td><td class="text-center p-3"><button class="btn btn-ghost btn-xs" onclick="editItem(${i.id})">Edit</button> <button class="btn btn-ghost btn-xs text-red-400" onclick="delItem(${i.id})">Delete</button></td></tr>`).join('');
}
function addItem() {
  const q = prompt('Question:'); if (!q) return;
  const a = prompt('Answer:'); if (!a) return;
  fetch('/admin/api/faq', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({question:q, answer:a})}).then(load);
}
function editItem(id) {
  const q = prompt('Question:'); if (q === null) return;
  const a = prompt('Answer:'); if (a === null) return;
  fetch('/admin/api/faq/'+id, {method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({question:q, answer:a})}).then(load);
}
async function delItem(id) { if (confirm('Delete?')) { await fetch('/admin/api/faq/'+id, {method:'DELETE'}); load(); } }
load();
</script>
