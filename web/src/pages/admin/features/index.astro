---
import Admin from "../../../layouts/Admin.astro";
---

<Admin title="Enterprise Features — Ceche Admin">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Enterprise Features</h1>
    <button class="btn btn-primary btn-sm" onclick="addItem()">Add Feature</button>
  </div>
  <div class="bg-base-200 rounded-xl border border-[#1a261a] overflow-x-auto">
    <table class="table table-sm w-full">
      <thead><tr class="text-[#9ca3af] text-sm border-b border-[#1a261a]"><th class="text-left p-3">Title</th><th class="text-left p-3">Description</th><th class="text-center p-3">Order</th><th class="text-center p-3">Actions</th></tr></thead>
      <tbody id="features-table"><tr><td colspan="4" class="text-center text-[#9ca3af] py-8">Loading...</td></tr></tbody>
    </table>
  </div>
</Admin>

<script>
async function load() {
  const r = await fetch('/admin/api/features'); const d = await r.json();
  const t = document.getElementById('features-table');
  if (!d.length) { t.innerHTML = '<tr><td colspan="4" class="text-center text-[#9ca3af] py-8">No features yet.</td></tr>'; return; }
  t.innerHTML = d.map(i => `<tr class="border-b border-[#1a261a]"><td class="p-3 font-medium">${i.title}</td><td class="p-3 text-sm text-[#9ca3af]">${(i.description||'').slice(0,80)}</td><td class="text-center p-3">${i.sort_order}</td><td class="text-center p-3"><button class="btn btn-ghost btn-xs" onclick="editItem(${i.id})">Edit</button> <button class="btn btn-ghost btn-xs text-red-400" onclick="delItem(${i.id})">Delete</button></td></tr>`).join('');
}
function addItem() {
  const t = prompt('Title:'); if (!t) return;
  const d = prompt('Description:'); if (!d) return;
  fetch('/admin/api/features', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({title:t, description:d})}).then(load);
}
function editItem(id) {
  const t = prompt('Title:'); if (t === null) return;
  const d = prompt('Description:'); if (d === null) return;
  fetch('/admin/api/features/'+id, {method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({title:t,description:d})}).then(load);
}
async function delItem(id) { if (confirm('Delete?')) { await fetch('/admin/api/features/'+id, {method:'DELETE'}); load(); } }
load();
</script>
