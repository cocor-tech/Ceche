---
import Admin from "../../layouts/Admin.astro";
---

<Admin title="Edit Documentation — Ceche Admin">
  <h1 class="text-2xl font-bold mb-6">Edit Documentation Page</h1>
  <div id="editor" class="max-w-3xl">
    <div class="text-center text-[#9ca3af] py-8">Loading editor...</div>
  </div>
</Admin>

<script>
async function init() {
  const params = new URLSearchParams(window.location.search);
  const docId = params.get('id');
  if (!docId) { document.getElementById('editor').innerHTML = '<p class="text-red-400">No document ID provided.</p>'; return; }

  const r = await fetch('/admin/api/docs/' + docId);
  const d = await r.json();

  document.getElementById('editor').innerHTML = `
    <form id="doc-form" class="space-y-4">
      <div><label class="label text-sm text-[#9ca3af]">Title</label><input id="title" class="input input-bordered w-full" value="${(d.title||'').replace(/"/g,'&quot;')}" required /></div>
      <div class="grid grid-cols-2 gap-4">
        <div><label class="label text-sm text-[#9ca3af]">Slug</label><input id="slug" class="input input-bordered w-full" value="${(d.slug||'').replace(/"/g,'&quot;')}" /></div>
        <div><label class="label text-sm text-[#9ca3af]">Category</label><select id="category" class="select select-bordered w-full"><option value="getting-started">Getting Started</option><option value="api">API</option><option value="cli">CLI</option><option value="tui">TUI</option><option value="guides">Guides</option></select></div>
      </div>
      <div><label class="label text-sm text-[#9ca3af]">Sort Order</label><input id="sort_order" type="number" class="input input-bordered w-24" value="${d.sort_order || 0}" /></div>
      <div><label class="label text-sm text-[#9ca3af]">Content (Markdown)</label><textarea id="content" class="textarea textarea-bordered w-full font-mono text-sm" rows="20">${(d.content||'').replace(/</g,'&lt;')}</textarea></div>
      <div class="flex gap-3"><button type="submit" class="btn btn-primary">Save</button> <a href="/admin/docs" class="btn btn-ghost">Cancel</a></div>
    </form>
  `;
  document.getElementById('category').value = d.category || '';

  document.getElementById('doc-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    await fetch('/admin/api/docs/' + docId, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({
      title: document.getElementById('title').value,
      slug: document.getElementById('slug').value,
      category: document.getElementById('category').value,
      sort_order: parseInt(document.getElementById('sort_order').value) || 0,
      content: document.getElementById('content').value,
    })});
    window.location = '/admin/docs';
  });
}
init();
</script>
