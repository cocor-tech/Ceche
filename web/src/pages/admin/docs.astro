---
import Admin from "../../layouts/Admin.astro";
---

<Admin title="Documentation — Ceche Admin">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Documentation Pages</h1>
  </div>
  <div class="bg-base-200 rounded-xl border border-base-300 overflow-x-auto">
    <table class="table table-sm w-full">
      <thead><tr class="text-base-content/60 text-sm border-b border-base-300"><th class="text-left p-3">Title</th><th class="text-center p-3">Category</th><th class="text-center p-3">Order</th><th class="text-center p-3">Actions</th></tr></thead>
      <tbody id="docs-table"><tr><td colspan="4" class="text-center text-base-content/60 py-8">Loading...</td></tr></tbody>
    </table>
  </div>
</Admin>

<script>
async function load() {
  try {
    const r = await fetch('/admin/api/docs');
    const d = await r.json();
    const t = document.getElementById('docs-table');
    if (!d.length) { t.innerHTML = '<tr><td colspan="4" class="text-center text-base-content/60 py-8">No docs yet.</td></tr>'; return; }
    t.innerHTML = d.map(p => `<tr class="border-b border-base-300"><td class="p-3"><a href="/admin/docs-edit?id=${p.id}" class="hover:text-primary">${p.title}</a></td><td class="text-center p-3"><span class="badge badge-ghost badge-sm">${p.category || '--'}</span></td><td class="text-center p-3">${p.sort_order || 0}</td><td class="text-center p-3"><a href="/admin/docs-edit?id=${p.id}" class="btn btn-ghost btn-xs">Edit</a> <button class="btn btn-ghost btn-xs text-red-400" onclick="del(${p.id})">Delete</button></td></tr>`).join('');
  } catch(e) {}
}
async function del(id) { if (confirm('Delete?')) { await fetch('/admin/api/docs/' + id, {method:'DELETE'}); load(); } }
load();
</script>
