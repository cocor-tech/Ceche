---
import Base from "../layouts/Base.astro";
---

<Base title="Page Not Found — Ceche" description="The page you're looking for doesn't exist.">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-32 text-center">
    <h1 class="text-7xl font-bold text-[#ff8800]">404</h1>
    <p class="mt-6 text-xl text-[#9ca3af]">This page doesn't exist.</p>
    <a href="/" class="btn btn-primary btn-lg mt-8">Go Home</a>
  </section>
</Base>
