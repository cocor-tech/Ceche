---
import Base from "../layouts/Base.astro";
---

<Base title="Page Not Found — Ceche" description="The page you are looking for does not exist.">
  <div class="min-h-[calc(100dvh-8rem)] flex items-center justify-center px-4">
    <div class="text-center max-w-md">
      <div class="text-display-1 font-display font-bold text-primary/30">404</div>
      <h1 class="text-heading-1 font-display mt-4">Page not found</h1>
      <p class="mt-3 text-body text-base-content/50">The page you are looking for does not exist or has been moved.</p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/" class="btn btn-primary">Go home</a>
        <a href="/" class="btn btn-outline">Appraise a domain</a>
      </div>
    </div>
  </div>
</Base>
