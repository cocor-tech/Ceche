---
import Base from "../layouts/Base.astro";
---

<Base title="Blog — Ceche" description="Domain investing tips, valuation guides, and industry insights from the Ceche team.">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center" data-aos="fade-up">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">Blog</h1>
      <p class="mt-4 text-lg text-[#9ca3af]">Domain investing, valuation guides, and industry insights.</p>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="blog-list">
      <div class="col-span-full text-center text-[#9ca3af] py-16">
        <div class="skeleton h-6 w-48 mx-auto mb-8"></div>
        <div class="skeleton h-4 w-64 mx-auto mb-4"></div>
        <div class="skeleton h-4 w-56 mx-auto"></div>
      </div>
    </div>
  </section>
</Base>

<script>
async function load() {
  try {
    const r = await fetch('/blog');
    const posts = await r.json();
    const container = document.getElementById('blog-list');

    if (!posts.length) {
      container.innerHTML = '<div class="col-span-full text-center text-[#9ca3af] py-16">No posts yet.</div>';
      return;
    }

    container.innerHTML = posts.map(post => `
      <a href="/blog/post?id=${post.slug}" class="card bg-base-200 border border-[#1a261a] p-6 hover:border-[#ff8800] transition-all block" data-aos="fade-up">
        <h2 class="text-lg font-semibold leading-snug">${post.title}</h2>
        ${post.excerpt ? `<p class="mt-3 text-sm text-[#9ca3af] line-clamp-3">${post.excerpt}</p>` : ''}
        <div class="mt-4 text-xs text-[#9ca3af]">${post.published_at ? new Date(post.published_at * 1000).toLocaleDateString() : ''}</div>
      </a>
    `).join('');
  } catch(e) {
    document.getElementById('blog-list').innerHTML = '<div class="col-span-full text-center text-red-400 py-16">Failed to load posts.</div>';
  }
}
load();
</script>
