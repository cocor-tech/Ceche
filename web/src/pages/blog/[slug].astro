---
import Base from "../../layouts/Base.astro";
export const prerender = false;
const { slug } = Astro.params;
---

<Base title="Blog Post — Ceche" description="Read the latest from Ceche.">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div id="post-content">
      <div class="text-center py-16">
        <div class="skeleton h-8 w-64 mx-auto mb-6"></div>
        <div class="skeleton h-4 w-48 mx-auto mb-4"></div>
        <div class="skeleton h-4 w-96 mx-auto mb-3"></div>
        <div class="skeleton h-4 w-80 mx-auto"></div>
      </div>
    </div>
    <div class="mt-12 text-center">
      <a href="/blog" class="text-sm text-[#ff8800] hover:underline">&larr; Back to Blog</a>
    </div>
  </section>
</Base>

<script>
const slug = '{slug}';

async function load() {
  if (!slug || slug === 'index') { window.location = '/blog'; return; }

  try {
    const r = await fetch('/blog/' + encodeURIComponent(slug));
    if (!r.ok) throw new Error('Not found');
    const post = await r.json();

    document.title = post.title + ' — Ceche';
    const metaDesc = document.querySelector('meta[name="description"]');
    if (metaDesc) metaDesc.setAttribute('content', post.excerpt || post.title);

    // Article schema
    const script = document.createElement('script');
    script.type = 'application/ld+json';
    script.textContent = JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": post.title,
      "description": post.excerpt || post.title,
      "datePublished": post.published_at ? new Date(post.published_at * 1000).toISOString() : undefined,
      "author": { "@type": "Organization", "name": "Ceche" }
    });
    document.head.appendChild(script);

    document.getElementById('post-content').innerHTML = `
      <article>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight leading-tight">${post.title}</h1>
        ${post.published_at ? `<p class="mt-3 text-sm text-[#9ca3af]">${new Date(post.published_at * 1000).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>` : ''}
        ${post.featured_image ? `<img src="${post.featured_image}" alt="${post.title}" class="mt-8 rounded-xl w-full" loading="lazy" />` : ''}
        <div class="mt-8 prose prose-invert prose-headings:text-white prose-headings:font-semibold prose-a:text-[#ff8800] prose-a:no-underline hover:prose-a:underline prose-strong:text-white prose-code:text-[#22c55e] prose-code:bg-[#0d120d] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-pre:bg-[#0a0a0f] prose-pre:border prose-pre:border-[#1a261a] prose-pre:rounded-xl prose-blockquote:border-l-[#ff8800] prose-blockquote:text-[#9ca3af] prose-li:marker:text-[#9ca3af] max-w-none">${renderMd(post.content || '')}</div>
      </article>
    `;
  } catch(e) {
    document.getElementById('post-content').innerHTML = '<p class="text-center text-red-400">Post not found.</p>';
  }
}

function renderMd(md) {
  if (!md) return '';
  let html = md
    // Escape HTML entities first
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    // Horizontal rules
    .replace(/^---$/gm, '<hr class="my-8 border-[#1a261a]" />')
    // Blockquotes
    .replace(/^&gt; (.+)$/gm, '<blockquote class="border-l-4 border-[#ff8800] pl-4 my-4 text-[#9ca3af] italic">$1</blockquote>')
    // Code blocks (fenced with ```)
    .replace(/```(\w*)\n([\s\S]*?)```/g, (_, lang, code) => {
      const langClass = lang ? ` class="language-${lang}"` : '';
      return `<pre class="bg-[#0a0a0f] border border-[#1a261a] rounded-xl p-4 my-6 overflow-x-auto"><code${langClass}>${code.trim().replace(/</g,'&lt;').replace(/>/g,'&gt;')}</code></pre>`;
    })
    // Inline code
    .replace(/`([^`]+)`/g, '<code class="text-[#22c55e] bg-[#0d120d] px-1.5 py-0.5 rounded text-sm font-mono">$1</code>')
    // Headings
    .replace(/^#### (.+)$/gm, '<h4 class="text-lg font-semibold mt-8 mb-3 text-white">$1</h4>')
    .replace(/^### (.+)$/gm, '<h3 class="text-xl font-semibold mt-10 mb-3 text-white">$1</h3>')
    .replace(/^## (.+)$/gm, '<h2 class="text-2xl font-semibold mt-12 mb-4 text-white">$1</h2>')
    .replace(/^# (.+)$/gm, '<h1 class="text-3xl font-bold mt-14 mb-4 text-white">$1</h1>')
    // Bold and italic
    .replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>')
    .replace(/\*\*(.+?)\*\*/g, '<strong class="text-white">$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>')
    // Images
    .replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1" class="rounded-xl w-full my-6" loading="lazy" />')
    // Links
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-[#ff8800] hover:underline" target="_blank" rel="noopener">$1</a>')
    // Unordered lists
    .replace(/^[\*\-] (.+)$/gm, '<li class="ml-5 list-disc text-[#c9d1d9] marker:text-[#9ca3af]">$1</li>')
    // Ordered lists
    .replace(/^\d+\. (.+)$/gm, '<li class="ml-5 list-decimal text-[#c9d1d9] marker:text-[#9ca3af]">$1</li>')
    // Paragraphs — wrap consecutive non-empty lines
    .replace(/\n\n/g, '</p><p class="mt-4 text-[#c9d1d9] leading-relaxed">');

  // Wrap in paragraph if not already wrapped
  if (!html.startsWith('<')) {
    html = '<p class="text-[#c9d1d9] leading-relaxed">' + html;
  }
  if (!html.endsWith('>')) {
    html = html + '</p>';
  }
  return html;
}

load();
</script>
