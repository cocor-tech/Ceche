---
import Base from "../../layouts/Base.astro";
import RenderMd from "../../components/RenderMd.astro";
export const prerender = false;
const { slug } = Astro.params;
let postData = null;
let fetchError = false;

try {
  const apiUrl = `http://127.0.0.1:8080/api/blog/${encodeURIComponent(slug)}`;
  const res = await fetch(apiUrl);
  if (res.ok) {
    postData = await res.json();
  } else {
    fetchError = true;
  }
} catch (e) {
  fetchError = true;
}

function fmtDate(d: unknown): string {
  if (!d) return '';
  const date = typeof d === 'number' ? new Date(d * 1000) : new Date(d as string);
  return isNaN(date.getTime()) ? '' : date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

function isoDate(d: unknown): string {
  if (!d) return '';
  const date = typeof d === 'number' ? new Date(d * 1000) : new Date(d as string);
  return isNaN(date.getTime()) ? '' : date.toISOString();
}
---

<Base title={postData ? `${postData.title} — Ceche` : "Blog Post — Ceche"} description={postData?.excerpt || "Read the latest from Ceche."}>
  {
    fetchError || !postData ? (
      <div class="min-h-[calc(100dvh-8rem)] flex items-center justify-center px-4">
        <div class="text-center max-w-md">
          <h1 class="text-heading-1 font-display">Post not found</h1>
          <p class="mt-3 text-body text-base-content/50">The blog post you are looking for does not exist.</p>
          <a href="/blog/" class="btn btn-primary mt-6">&larr; Back to Blog</a>
        </div>
      </div>
    ) : (
      <>
        <section class="block md:hidden px-4 pt-6 pb-4">
          <article>
            <h1 class="text-heading-1 font-display leading-tight">{postData.title}</h1>
            {fmtDate(postData.published_at) ? <p class="mt-2 text-body-sm text-base-content/50">{fmtDate(postData.published_at)}</p> : ''}
            <div class="mt-5 text-body text-base-content/80 leading-relaxed">
              <RenderMd content={postData.content} />
            </div>
          </article>
          <div class="mt-8 text-center">
            <a href="/blog/" class="text-body-sm text-primary hover:underline">&larr; Back to Blog</a>
          </div>
        </section>

        <section class="hidden md:block max-w-7xl mx-auto px-6 py-16">
          <div class="grid grid-cols-[240px_1fr] gap-12">
            <div class="sticky top-24 self-start">
              <a href="/blog/" class="text-body-sm text-primary hover:underline flex items-center gap-1.5 mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
                Back to Blog
              </a>
              <nav id="toc-desktop" class="text-body-sm text-base-content/50 space-y-2"></nav>
            </div>
            <article class="max-w-3xl">
              <h1 class="text-display-2 font-display leading-tight">{postData.title}</h1>
              {fmtDate(postData.published_at) ? <p class="mt-3 text-body text-base-content/50">{fmtDate(postData.published_at)}</p> : ''}
              <div class="mt-10 text-body-lg text-base-content/80 leading-relaxed">
                <RenderMd content={postData.content} />
              </div>
            </article>
          </div>
        </section>

        <Fragment set:html={`
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Article",
          "headline": ${JSON.stringify(postData.title)},
          "description": ${JSON.stringify(postData.excerpt || postData.title)},
          "datePublished": "${isoDate(postData.published_at)}",
          "author": { "@type": "Organization", "name": "Ceche" }
        }
        </script>
        `} />
      </>
    )
  }
</Base>

<script>
(function() {
  var toc = document.getElementById('toc-desktop');
  if (toc) {
    var headings = document.querySelectorAll('article h2');
    if (headings.length > 1) {
      toc.innerHTML = '<p class="text-caption text-base-content/30 uppercase tracking-wider mb-3">On this page</p>';
      headings.forEach(function(h2) {
        var id = h2.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        h2.id = id;
        var a = document.createElement('a');
        a.href = '#' + id;
        a.className = 'block text-body-sm text-base-content/50 hover:text-primary transition-colors py-1';
        a.textContent = h2.textContent;
        toc.appendChild(a);
      });
    }
  }
})();
</script>
