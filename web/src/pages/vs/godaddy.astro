---
import Base from "../../layouts/Base.astro";

const title = "Ceche vs GoDaddy — Domain Appraisal Comparison";
const description = "Compare Ceche's 16-module domain appraisal engine against GoDaddy Appraisal. See which tool gives more accurate, transparent domain valuations.";
---

<Base title={title} description={description}>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div data-aos="fade-up">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">Ceche vs GoDaddy</h1>
      <p class="mt-4 text-lg text-[#9ca3af]">An honest comparison of domain appraisal tools.</p>
    </div>

    <div class="mt-12 overflow-x-auto" data-aos="fade-up" data-aos-delay="100">
      <table class="table table-lg w-full">
        <thead>
          <tr class="text-[#9ca3af] text-sm uppercase tracking-wider border-b border-[#1a261a]">
            <th class="py-4 text-left">Feature</th>
            <th class="py-4 text-center text-[#ff8800]">Ceche</th>
            <th class="py-4 text-center">GoDaddy</th>
          </tr>
        </thead>
        <tbody>
          {[
            ["Valuation Modules", "16", "5-7"],
            ["AI-Powered", "Yes — segmentation, CPC, TM", "Limited"],
            ["Bulk Appraisal", "Unlimited (CLI)", "Limited"],
            ["API Access", "REST API", "Paid API"],
            ["Open Source", "Yes (MIT)", "No"],
            ["Price", "Free (CLI) / $49/mo (API)", "$5-50 per appraisal"],
            ["Transparency", "Full module breakdown", "Black box"],
            ["Terminal UI", "Yes (Textual)", "No"],
            ["Offline Mode", "Yes", "No"],
            ["Self-Hostable", "Yes", "No"],
            ["Data Sources", "RDAP, Ahrefs, OPR, Google, Wayback, USPTO", "Proprietary"],
          ].map(([feature, ceche, them]) => (
            <tr class="border-b border-[#1a261a]">
              <td class="py-4 font-medium">{feature}</td>
              <td class="py-4 text-center text-green-400">{ceche}</td>
              <td class="py-4 text-center text-[#9ca3af]">{them}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-16 text-center" data-aos="fade-up" data-aos-delay="200">
      <h2 class="text-2xl font-bold">Try Ceche free today</h2>
      <p class="mt-2 text-[#9ca3af]">No credit card. No limits. Open source.</p>
      <a href="/appraise" class="btn btn-primary btn-lg mt-6">Appraise a Domain</a>
    </div>
  </section>
</Base>
