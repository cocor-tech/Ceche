---
import Base from "../../layouts/Base.astro";

const title = "Ceche vs Estibot — Domain Appraisal Comparison";
const description = "See how Ceche compares to Estibot for domain valuation. Ceche offers more modules, full transparency, AI enhancement, and is open source.";
---

<Base title={title} description={description}>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div data-aos="fade-up">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">Ceche vs Estibot</h1>
      <p class="mt-4 text-lg text-[#9ca3af]">A transparent comparison of domain appraisal platforms.</p>
    </div>

    <div class="mt-12 overflow-x-auto" data-aos="fade-up" data-aos-delay="100">
      <table class="table table-lg w-full">
        <thead>
          <tr class="text-[#9ca3af] text-sm uppercase tracking-wider border-b border-[#1a261a]">
            <th class="py-4 text-left">Feature</th>
            <th class="py-4 text-center text-[#ff8800]">Ceche</th>
            <th class="py-4 text-center">Estibot</th>
          </tr>
        </thead>
        <tbody>
          {[
            ["Valuation Modules", "16", "5"],
            ["AI Enhancement", "Yes (opt-in)", "Limited"],
            ["Bulk Appraisal", "Unlimited (CLI)", "Paid only"],
            ["API Access", "REST API", "Paid API"],
            ["Open Source", "Yes (MIT)", "No"],
            ["Price", "Free / $49/mo", "$5-50 per report"],
            ["Module Breakdown", "Full transparency", "Limited"],
            ["CLI Tool", "Yes", "No"],
            ["Terminal UI", "Yes", "No"],
            ["Offline Appraisal", "Yes", "No"],
            ["Self-Hosted", "Yes", "No"],
            ["Trademark Checking", "USPTO + AI", "No"],
            ["Authority Data", "Ahrefs, OPR, Wayback", "Proprietary"],
            ["Cache System", "Configurable TTL", "Unknown"],
          ].map(([feature, ceche, them]) => (
            <tr class="border-b border-[#1a261a]">
              <td class="py-4 font-medium">{feature}</td>
              <td class="py-4 text-center text-green-400">{ceche}</td>
              <td class="py-4 text-center text-[#9ca3af]">{them}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-16 text-center" data-aos="fade-up" data-aos-delay="200">
      <h2 class="text-2xl font-bold">Get more from your domain data</h2>
      <p class="mt-2 text-[#9ca3af]">Try Ceche. It's free, transparent, and built for investors.</p>
      <a href="/appraise" class="btn btn-primary btn-lg mt-6">Appraise Now</a>
    </div>
  </section>
</Base>
