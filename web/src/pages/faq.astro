---
import Base from "../layouts/Base.astro";
const title = "FAQ — Ceche";
const description = "Frequently asked questions about domain appraisal, valuation factors, and how Ceche determines domain value.";
---

<Base title={title} description={description}>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="text-center" data-aos="fade-up">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">Frequently Asked Questions</h1>
      <p class="mt-4 text-lg text-[#9ca3af]">Everything you need to know about Ceche.</p>
    </div>
    <div id="faq-container" class="mt-16 space-y-4" data-aos="fade-up" data-aos-delay="100">
      <div class="text-center text-[#9ca3af] py-8"><div class="skeleton h-6 w-64 mx-auto mb-4"></div><div class="skeleton h-4 w-48 mx-auto"></div></div>
    </div>
  </section>
</Base>

<script>
async function load() {
  try {
    const r = await fetch('/api/faq');
    const items = await r.json();
    const container = document.getElementById('faq-container');
    if (!items.length) { container.innerHTML = '<p class="text-center text-[#9ca3af]">No FAQs yet.</p>'; return; }
    container.innerHTML = items.map((item, i) => `
      <div class="collapse collapse-plus bg-base-200 border border-[#1a261a] rounded-xl">
        <input type="checkbox" />
        <div class="collapse-title text-base font-medium">${item.question}</div>
        <div class="collapse-content text-sm text-[#9ca3af]">${item.answer}</div>
      </div>
    `).join('');
    // JSON-LD structured data
    const script = document.createElement('script');
    script.type = 'application/ld+json';
    script.textContent = JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": items.map(i => ({ "@type": "Question", "name": i.question, "acceptedAnswer": { "@type": "Answer", "text": i.answer } }))
    });
    document.head.appendChild(script);
  } catch(e) {
    document.getElementById('faq-container').innerHTML = '<p class="text-center text-red-400">Failed to load FAQs.</p>';
  }
}
load();
</script>
