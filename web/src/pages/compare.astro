---
import Base from "../layouts/Base.astro";
---

<Base title="Domain Appraisal Comparison — Ceche" description="Compare Ceche with other domain appraisal tools.">
  <!-- Mobile -->
  <section class="block md:hidden px-4 pt-6 pb-4">
    <div id="compare-content-mobile">
      <div class="skeleton h-6 w-48 mb-2"></div>
      <div class="skeleton h-3 w-64 mb-6"></div>
      <div class="skeleton h-40 w-full"></div>
    </div>
  </section>

  <!-- Desktop -->
  <section class="hidden md:block max-w-5xl mx-auto px-6 py-24">
    <div id="compare-content-desktop" class="space-y-10">
      <div class="skeleton h-10 w-96 mb-2"></div>
      <div class="skeleton h-5 w-[500px] mb-8"></div>
      <div class="skeleton h-80 w-full"></div>
    </div>
  </section>
</Base>

<script>
async function load() {
  const params = new URLSearchParams(window.location.search);
  const slug = params.get('slug') || window.location.pathname.split('/').filter(Boolean).pop();
  try {
    const r = await fetch('/api/comparisons');
    const all = await r.json();
    const comp = all.find(c => c.slug === slug);
    if (!comp) {
      document.querySelectorAll('#compare-content-mobile, #compare-content-desktop').forEach(el => el.innerHTML = '<p class="text-error">Comparison not found.</p>');
      return;
    }
    document.title = comp.meta_title || 'Ceche vs ' + comp.competitor + ' — Comparison';
    const metaDesc = document.querySelector('meta[name="description"]');
    if (metaDesc && comp.meta_description) metaDesc.setAttribute('content', comp.meta_description);

    const rows = comp.rows || [];
    const tableHtml = rows.length ? `
      <div class="overflow-x-auto">
        <table class="table w-full">
          <thead>
            <tr class="text-caption text-base-content/40 uppercase tracking-wider border-b border-base-300">
              <th class="py-4 text-left font-medium">Feature</th>
              <th class="py-4 text-center font-medium text-primary">Ceche</th>
              <th class="py-4 text-center font-medium text-base-content/50">${comp.competitor}</th>
            </tr>
          </thead>
          <tbody>
            ${rows.map(r => {
              const feature = r.feature || r[0] || '';
              const us = r.ceche || r.us || r[1] || '';
              const them = r.them || r.competitor || r[2] || '';
              return '<tr class="border-b border-base-300"><td class="py-3.5 text-body-sm font-medium">' + feature + '</td><td class="py-3.5 text-center text-body-sm text-secondary">' + us + '</td><td class="py-3.5 text-center text-body-sm text-base-content/50">' + them + '</td></tr>';
            }).join('')}
          </tbody>
        </table>
      </div>
    ` : '';

    const mobileEl = document.getElementById('compare-content-mobile');
    if (mobileEl) {
      mobileEl.innerHTML = `
        <h1 class="text-heading-1 font-display">Ceche vs ${comp.competitor}</h1>
        <p class="mt-1 text-body-sm text-base-content/50 mb-5">${comp.meta_description || ''}</p>
        ${tableHtml}
        <div class="mt-8 text-center">
          <a href="/" class="btn btn-primary w-full">Try Ceche Free</a>
        </div>
      `;
    }

    const desktopEl = document.getElementById('compare-content-desktop');
    if (desktopEl) {
      desktopEl.innerHTML = `
        <div>
          <p class="text-caption text-primary uppercase tracking-wider">Comparison</p>
          <h1 class="text-display-2 font-display mt-2">Ceche vs ${comp.competitor}</h1>
          <p class="mt-3 text-body-lg text-base-content/60">${comp.meta_description || ''}</p>
        </div>
        ${tableHtml}
        <div class="text-center pt-8">
          <h2 class="text-heading-1 font-display">Try Ceche free today</h2>
          <p class="mt-2 text-body text-base-content/50">No credit card. No limits. Open source.</p>
          <a href="/" class="btn btn-primary btn-lg mt-6">Appraise a Domain</a>
        </div>
      `;
    }
  } catch {
    document.querySelectorAll('#compare-content-mobile, #compare-content-desktop').forEach(el => el.innerHTML = '<p class="text-error">Failed to load comparison.</p>');
  }
}
load();
</script>
