# Ceche Web — Environment Variables
# Copy to .env and fill in values

# Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ceche
MYSQL_PASSWORD=
MYSQL_DATABASE=ceche

# Admin
CECHE_ADMIN_SECRET=change-this-to-a-random-secret
CECHE_ADMIN_PASSWORD=set-your-admin-password-here

# API
CECHE_API_URL=http://localhost:8080
