# Ceche Docker — Environment Variables
# Copy to .env and fill in values

# Admin credentials (set these before first run)
CECHE_ADMIN_SECRET=generate-a-random-secret-here
CECHE_ADMIN_PASSWORD=set-your-admin-password-here

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ceche
MYSQL_USER=ceche
MYSQL_PASSWORD=ceche
CECHE_MYSQL_HOST=mysql
CECHE_MYSQL_PORT=3306
CECHE_MYSQL_USER=ceche
CECHE_MYSQL_PASSWORD=ceche
CECHE_MYSQL_DATABASE=ceche
